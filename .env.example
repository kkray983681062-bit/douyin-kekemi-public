APP_ENV=development
AUTH_REQUIRED=0
PORT=5000
MAX_ROOMS=10
SQLITE_DB_PATH=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy migration fallback only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
REGISTRATION_INVITE_CODE=
APP_SESSION_SECRET=
SUPABASE_RESET_REDIRECT_URL=http://127.0.0.1:5000/reset-password
AUTH_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_RECOVERY_ATTEMPTS=5
AUTH_RECOVERY_WINDOW_SECONDS=3600

# Douyin listener credentials remain server-side too.
DY_COOKIES=
DY_LIVE_COOKIES=

# Supply only your own authorized targets locally.
DEFAULT_WATCH_IDS=
ONLINE_SYNC_INTERVAL=3
MIC_TICKET_REFRESH_INTERVAL=3
RESPONSE_CACHE_TTL=1.0
SILENCE_THRESHOLD_SECONDS=900
SILENCE_SCAN_INTERVAL=60

# Optional tools; no production endpoint or embedded IM key is provided.
DEPLOY_BASE_URL=
DY_IM_APP_KEY=
DY_PROFILE_URL=
